---
import KistSprite from './KistSprite.astro';
interface Props { mode?: 'run' | 'groove'; id?: string; }
const {mode='run',id}=Astro.props;
---
<div class:list={['arcade-interlude',`arcade-${mode}`]} data-arcade-interlude data-kind={mode} id={id} data-world-act="0">
 <div class="world-visual" aria-hidden="true">
  <canvas class="arcade-harmonics"></canvas>
  <div class:list={['arcade-character',mode==='run'?'arcade-runner':'arcade-dancer']}>
    <KistSprite mode={mode} size={144}/>
  </div>
  <div class="arcade-horizon"></div>
 </div>
 {mode==='run' && <><div class="world-heading"><span>KIST / ANOTHER DIMENSION</span><p>Follow the<br/><em>frequency.</em></p></div><div class="world-footer"><div class="world-chapters" aria-hidden="true"><span data-world-chapter="0">01 / NIGHT DRIVE</span><span data-world-chapter="1">02 / FREQUENCY BLOCKS</span><span data-world-chapter="2">03 / AFTERHOURS MAZE</span></div><a href="#diary">La prossima notte <span aria-hidden="true">↗</span></a></div></>}
 <button class="world-pause" aria-pressed="false" aria-label="Metti in pausa lo sfondo animato"><span aria-hidden="true">Ⅱ</span></button>
</div>
<style>
 .arcade-interlude.arcade-run{height:clamp(400px,52vw,660px);background:#090b17}
 .arcade-interlude.arcade-groove{height:320px;background:#090b17}
 .world-visual{position:absolute;inset:0;overflow:hidden;pointer-events:none}
 .world-visual:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#090b17 0,transparent 24%,transparent 76%,#090b17 100%);pointer-events:none}
 .arcade-interlude .arcade-character{bottom:47px;width:clamp(100px,12vw,168px);z-index:2}
 .arcade-interlude .arcade-horizon{bottom:47px}
 .arcade-groove .arcade-character{width:130px}
 .world-heading{position:absolute;top:9%;left:6%;z-index:3;pointer-events:none}
 .world-heading>span{font-size:9px;letter-spacing:.2em;color:#b7abdc}
 .world-heading p{font-family:'Space Grotesk',sans-serif;font-size:clamp(38px,5.5vw,82px);letter-spacing:-.055em;line-height:1.02;margin:22px 0;color:#f1edff}
 .world-heading em{font-family:Georgia,serif;font-weight:400;color:#c9ff52}
 .world-footer{position:absolute;inset:auto 6% 18px;display:flex;justify-content:space-between;align-items:center;gap:12px;z-index:3;font-size:10px}
 .world-chapters{color:#b3afc8;letter-spacing:.12em;min-height:14px}
 .world-chapters span{display:none}
 [data-world-act='0'] [data-world-chapter='0'],[data-world-act='1'] [data-world-chapter='1'],[data-world-act='2'] [data-world-chapter='2']{display:block}
 .world-footer a{color:#c9ff52;white-space:nowrap;padding:8px 0}
 .world-pause{position:absolute;top:24px;right:6%;z-index:4;width:40px;height:40px;border-radius:50%;border:1px solid #ffffff38;background:#090b17b3;color:#e3dcff;font-size:16px;backdrop-filter:blur(10px)}
 .world-pause:hover{border-color:#c9ff52;color:#c9ff52}
 @media(max-width:600px){.arcade-interlude.arcade-run{height:460px}.arcade-interlude.arcade-groove{height:270px}.world-heading{top:11%}.world-heading p{font-size:44px}.world-heading>span{font-size:8px}.world-chapters{font-size:8px;letter-spacing:.06em}.world-footer{inset:auto 6% 14px}.world-footer a{font-size:9px}.world-pause{top:22px}.arcade-interlude .arcade-character{bottom:47px;width:116px}}
</style>
