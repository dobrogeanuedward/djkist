 <div class="gate-journey" aria-hidden="true"><span class="gate-coordinate">PORTICI / PIAZZA / TETTI</span><div class="gate-character" data-pose="run" data-facing="right"><div data-gate-pose="run"><KistSprite mode="run" size={136}/></div><div data-gate-pose="groove" hidden><KistSprite mode="groove" size={136}/></div></div><img class="gate-foreground" src="/media/world/bologna-foreground-v1.webp" alt="" decoding="async" loading="lazy"/><span class="gate-world-caption">PERSONAL FREQUENCY / 16 BIT BOLOGNA</span></div>
</section>
