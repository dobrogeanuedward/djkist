---
import KistSprite from './KistSprite.astro';
import { artist } from '../data/artist';
import WorldExperience from './WorldExperience.astro';
---
<section class="world-gate section" id="frequency-break" aria-labelledby="world-gate-title">
 <WorldExperience/>
 <div class="gate-copy"><span class="world-eyebrow">BOLOGNA / KIST WORLD</span><h2 id="world-gate-title">Bologna, sulla tua frequenza.</h2><p>Scorri. Segui KIST.</p></div>
 <div class="gate-journey" aria-hidden="true"><span class="gate-coordinate">PORTICI / PIAZZA / TETTI</span><div class="gate-character" data-pose="groove" data-facing="right"><div data-gate-pose="run" hidden><KistSprite mode="run" size={136} preload/></div><div data-gate-pose="groove"><KistSprite mode="groove" size={136} preload/></div></div><span class="gate-world-caption">BOLOGNA / PERSONAL FREQUENCY</span></div>
 <a class="gate-follow" href={artist.instagram} target="_blank" rel="noopener noreferrer" aria-label="Segui KIST su Instagram"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/><circle cx="17.6" cy="6.5" r="1.15" fill="currentColor"/></svg><span>Segui</span></a>
</section>

