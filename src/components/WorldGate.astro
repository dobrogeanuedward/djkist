---
import KistSprite from './KistSprite.astro';
import WorldExperience from './WorldExperience.astro';
---
<section class="world-gate section" id="frequency-break" aria-labelledby="world-gate-title">
 <WorldExperience/>
 <div class="gate-copy"><span class="world-eyebrow">BOLOGNA / KIST WORLD</span><h2 id="world-gate-title">Bologna, sulla tua frequenza.</h2><p>Scorri. Segui KIST.</p></div>
 <div class="gate-journey" aria-hidden="true"><span class="gate-coordinate">PORTICI / PIAZZA / TETTI</span><div class="gate-character" data-pose="groove" data-facing="right"><div data-gate-pose="run" hidden><KistSprite mode="run" size={136}/></div><div data-gate-pose="groove"><KistSprite mode="groove" size={136}/></div></div><span class="gate-world-caption">BOLOGNA / PERSONAL FREQUENCY</span></div>
 <button id="world-motion" class="world-motion" aria-pressed="false" aria-label="Metti in pausa la scena"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10 M13 5v10"/></svg><span data-world-motion-label>Pausa scena</span></button>
</section>
