---
interface Props { class?: string; }
const {class:className=''}=Astro.props;
---
<div class:list={['night-sky',className]} data-night-sky>
 <canvas class="night-sky-canvas" data-night-sky-canvas aria-hidden="true"></canvas>
 <button class="night-sky-toggle" data-night-sky-toggle aria-label="Metti in pausa il cielo stellato" title="Metti in pausa il cielo stellato" aria-pressed="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path data-night-sky-icon d="M7 5v10 M13 5v10"/></svg></button>
</div>
<style>
 .night-sky{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none;contain:layout paint;background:radial-gradient(ellipse at 92% 16%,#3e226b1f,transparent 45%),radial-gradient(ellipse at 4% 78%,#25404f18,transparent 50%)}
 .night-sky-canvas{position:absolute;inset:0;display:block;width:100%;height:100%;pointer-events:none;mask-image:linear-gradient(180deg,transparent,#000 6%,#000 94%,transparent)}
 .night-sky-toggle{position:absolute;top:20px;right:6%;z-index:2;display:grid;place-items:center;width:44px;height:44px;padding:12px;border:1px solid #b8a0e738;border-radius:50%;background:#100d1f66;color:#c8c0e6;pointer-events:auto;transition:border-color .2s,background .2s}
 .night-sky-toggle:hover{border-color:#b99affaa;background:#20162dba}
 .night-sky-toggle svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round}
 .night-sky-toggle:focus-visible{outline:2px solid #a1e4ee;outline-offset:4px}
 @media(max-width:700px){.night-sky-toggle{top:8px;right:20px}}
 @media(prefers-reduced-motion:reduce){.night-sky-toggle{display:none}}
 @media(forced-colors:active){.night-sky{display:none}}
</style>
<script src="../scripts/night-sky.ts"></script>
