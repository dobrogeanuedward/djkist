---
import KistSprite from './KistSprite.astro';
import {CHANNELS as channels, STYLES, SCENES} from '../scripts/bside-presets';
import '../styles/bside.css';
import '../styles/bside-lab.css';
---
<div class="bside-discovery">
 <button id="bside-entry" type="button" aria-label="Scopri il lato B" aria-haspopup="dialog" aria-controls="bside-room"><span class="bside-secret-record" aria-hidden="true"><i>B</i></span><span class="bside-door-copy">C’è un altro lato.</span></button>
</div>
<dialog id="bside-room" aria-labelledby="bside-title" aria-describedby="bside-description" data-playing="false" data-light="violet" data-style="garage" data-scene="groove" data-pending="false">
 <div class="bside-shell">
  <div class="bside-chrome"><a class="bside-identity" href="#" aria-label="KIST, chiudi il lato B"><img src="/media/kist-wordmark-v2.svg" width="86" height="28" alt="KIST"/><span>lato B</span></a><span class="bside-room-time"><i></i> Bologna, fuori orario.</span><button id="bside-close" type="button" aria-label="Chiudi il lato B" autofocus><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
  <div class="bside-intro"><div><p class="bside-found"><span></span> KIST. Play your frequency.</p><h2 id="bside-title">Il tuo<br/>lato B.</h2></div><p id="bside-description">Scegli il groove. Accendi la console.<br/>Il resto è nelle tue mani.</p></div>
  <div class="bside-studio" aria-label="Lo studio segreto di KIST">
   <div class="bside-room-wash" aria-hidden="true"></div>
   <div class="bside-wall-word" aria-hidden="true"><img src="/media/kist-wordmark-v2.svg" width="600" height="197" alt=""/></div>
   <div class="bside-window" aria-hidden="true"><div class="bside-window-sky"></div><div class="bside-moon"></div><svg class="bside-skyline" viewBox="0 0 360 240"><path d="M0 225V166h38v-18h48v28h28V81h22v-9h16v153h15V46h19V31h8v15h18v179h24v-59h24v-16h49v22h51v53Z"/><path class="bside-window-lights" d="M119 105h7v10h-7zm0 32h7v10h-7zm0 32h7v10h-7zm59-96h7v10h-7zm0 34h7v10h-7zm0 34h7v10h-7zm0 34h7v10h-7zM12 185h7v10h-7zm32-22h7v10h-7zm210 13h7v10h-7zm31 15h7v10h-7z"/></svg><div class="bside-window-cross"></div><span>44°29′ N / 11°20′ E</span></div>
   <div class="bside-speaker bside-speaker-left" aria-hidden="true"><span></span><i></i><b></b></div><div class="bside-speaker bside-speaker-right" aria-hidden="true"><span></span><i></i><b></b></div>
   <button class="bside-snapshot" id="bside-photo" type="button" aria-label="Gira la foto di KIST" aria-pressed="false"><span class="bside-snapshot-front"><img src="/media/kist-fifteen-frames-clean-second.webp" width="200" height="150" alt="KIST alla console" loading="lazy"/><span>one more track.</span></span><span class="bside-snapshot-back"><img src="/media/hero/kist-mural-portrait-mobile-v1.webp" width="200" height="150" alt="KIST con le cuffie davanti a un murale" loading="lazy"/><span>always KIST.</span></span></button>
   <div class="bside-neon" aria-hidden="true">ancora una.</div>
   <div class="bside-character"><KistSprite mode="mix" size={210} label="KIST alla console del lato B"/></div>
   <div class="bside-desk" aria-hidden="true"><div class="bside-deck bside-deck-left"><div class="bside-vinyl"><span><img src="/kist-sigil.svg" alt="" width="28" height="28"/></span></div><div class="bside-tonearm"></div><i class="bside-deck-led"></i></div><div class="bside-mixer"><div class="bside-meter"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="bside-knobs"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="bside-faders"><i></i><i></i><i></i></div><span>K / B</span></div><div class="bside-deck bside-deck-right"><div class="bside-vinyl"><span>B</span></div><div class="bside-tonearm"></div><i class="bside-deck-led"></i></div></div>
   <div class="bside-desk-edge" aria-hidden="true"><span>KIST / personal frequency machine</span><i></i></div>
   <button id="bside-lights" type="button" aria-label="Cambia la luce dello studio" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6m-5 3h4M8 14a6 6 0 1 1 8 0c-1 1-1 2-1 2H9s0-1-1-2Z"/></svg><span>Luci</span></button>
  </div>
  <div class="bside-instrument">
   <div class="bside-lab-heading"><img src="/media/kist-wordmark-v2.svg" width="60" height="20" alt="KIST"/><span>Personal frequency machine</span><span id="bside-preset-caption">UK garage / Groove</span></div>
   <div class="bside-styles" role="group" aria-label="Scegli il tuo suono">{STYLES.map(style=><button id={'bside-style-'+style.id} data-bside-style={style.id} type="button" aria-pressed={style.id==='garage'} style={'--style-color:'+style.color}>{style.name}</button>)}</div>
   <div class="bside-scene-row"><div class="bside-scenes" role="group" aria-label="Scegli il momento della serata">{SCENES.map(scene=><button id={'bside-scene-'+scene.id} data-bside-scene={scene.id} type="button" aria-pressed={scene.id==='groove'}>{scene.name}</button>)}</div><span id="bside-pending" role="status" aria-live="polite" hidden>Al prossimo giro.</span></div>
   <div class="bside-transport"><button id="bside-start" type="button"><svg class="bside-start-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7Z"/></svg><span>Accendi la stanza</span></button><div class="bside-clock"><span class="bside-clock-dot"></span><output id="bside-beat" aria-label="Battuta" aria-live="off">1 / 1.1</output><span>/ 2 battute</span></div><label class="bside-tempo-inline"><span>BPM</span><input id="bside-tempo" type="range" min="110" max="180" value="132" aria-label="Velocità del ritmo"/><output id="bside-tempo-value" for="bside-tempo">132</output></label></div>
   <div class="bside-performance"><div class="bside-voices"><div class="bside-pads" role="group" aria-label="Suona i nove pad">{channels.map(channel=><button class="bside-pad" type="button" data-bside-pad={channel.id} style={'--pad-color:'+channel.color} aria-label={'Suona '+channel.name}><span class="bside-pad-top"><i></i><kbd>{channel.key}</kbd></span><strong>{channel.name}</strong><span class="bside-pad-lines" aria-hidden="true"></span></button>)}</div><p class="bside-pad-hint">Nove voci. Tutte da suonare. <span>Da tastiera: 1–9.</span></p></div><div class="bside-expression"><button id="bside-xy" type="button" aria-label="Gioca con filtro ed eco. Tieni premuto e muovi, oppure usa le frecce." aria-pressed="false"><svg class="bside-xy-wave" viewBox="0 0 300 180" preserveAspectRatio="none" aria-hidden="true"><path d="M0 90h65c18 0 16-45 32-45s15 90 31 90 16-90 32-90 15 45 34 45h106M0 99h65c18 0 16-45 32-45s15 90 31 90 16-90 32-90 15 45 34 45h106M0 81h65c18 0 16-45 32-45s15 90 31 90 16-90 32-90 15 45 34 45h106"/></svg><i class="bside-xy-cursor"></i><span class="bside-xy-caption">Il suono, tra le dita.</span><span class="bside-xy-axis">filtro / eco</span></button><span class="bside-xy-hint">Premi e muovi. Quando lasci, torna il groove.</span></div></div>
   <div class="bside-macros"><label class="bside-dial"><span>Energia <output for="bside-energy">62%</output></span><input id="bside-energy" type="range" min="0" max="100" value="62" aria-label="Energia del groove"/></label><label class="bside-dial"><span>Spazio <output for="bside-space">28%</output></span><input id="bside-space" type="range" min="0" max="100" value="28" aria-label="Spazio e riverbero"/></label><label class="bside-dial"><span>Filtro <output for="bside-filter">58%</output></span><input id="bside-filter" type="range" min="0" max="100" value="58" aria-label="Filtro del suono"/></label></div>
   <div class="bside-vocal-control"><span>Vocal sintetizzati <small>Suona il pad 9.</small></span><label for="bside-vocal">Timbro della voce</label><select id="bside-vocal" aria-label="Timbro della voce sintetizzata"><option value="air">Air / ah–oh</option><option value="club" selected>Club / hey–ya</option><option value="robot">Robot / e–o</option></select></div>
   <div class="bside-play-actions"><button id="bside-shuffle" type="button" aria-label="Crea un altro ritmo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h3c5 0 7 12 12 12h3m-4-4 4 4-4 4M3 18h3c2 0 3-2 5-6m3-4c1-1 2-2 4-2h3m-4-4 4 4-4 4"/></svg><span>Un’altra versione</span></button><button id="bside-fill" type="button">Fill <span>Un colpo di scena</span></button><button id="bside-undo" type="button" disabled>Indietro</button></div>
   <details class="bside-pattern"><summary>Dentro il groove<span>Sequencer e dettagli <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 8 5 5 5-5"/></svg></span></summary><div class="bside-detail-controls"><div class="bside-banks" role="group" aria-label="Modifica la battuta"><button id="bside-bank-0" type="button" aria-pressed="true">Battuta 1</button><button id="bside-bank-1" type="button" aria-pressed="false">Battuta 2</button></div><label class="bside-dial"><span>Swing <output for="bside-swing">16%</output></span><input id="bside-swing" type="range" min="0" max="32" value="16" aria-label="Swing del ritmo"/></label><label class="bside-key-label">Tonalità<select id="bside-key" aria-label="Tonalità musicale">{['Do','Do♯','Re','Mi♭','Mi','Fa','Fa♯','Sol','La♭','La','Si♭','Si'].map((key,i)=><option value={36+i}>{key} minore</option>)}</select></label></div><div class="bside-sequencer-scroll" tabindex="0" role="region" aria-label="Sequencer, scorri per tutti i sedici passi della battuta"><div class="bside-sequencer">{channels.map(channel=><div class="bside-sequence" style={'--pad-color:'+channel.color}><button type="button" data-bside-channel={channel.id} aria-label={'Disattiva '+channel.name} aria-pressed="true">{channel.name}</button><div>{Array.from({length:16},(_,step)=><button type="button" data-bside-step data-channel={channel.id} data-step={step} aria-label={channel.name+', passo '+(step+1)} aria-pressed="false"><span>{step+1}</span></button>)}</div></div>)}</div></div><p>Tocca un passo per accenderlo. Toccalo ancora per toglierlo. I nomi accendono e spengono le voci.</p></details>
  </div>
  <div class="bside-outro"><p id="bside-status" role="status" aria-live="polite">Il tuo prossimo groove comincia qui.</p><div class="bside-session-actions"><button id="bside-save" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h13l3 3v15H3V3Zm2 0v7h10V3M7 21v-7h10v7"/></svg><span>Salva qui</span></button><button id="bside-export" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></svg><span>Esporta WAV</span></button><button id="bside-share" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-2 2m3 6a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l2-2"/></svg><span>Passa il groove</span></button></div><a id="bside-download" hidden>Il tuo WAV è pronto. Scaricalo.</a></div>
  <div class="bside-signature" aria-hidden="true"><span>You found the B-side.</span><img src="/kist-sigil.svg" width="22" height="22" alt=""/><span>Keep the night going.</span></div>
 </div>
</dialog>
<script src="../scripts/bside.ts"></script>
