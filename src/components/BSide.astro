---
import KistSprite from './KistSprite.astro';
import '../styles/bside.css';
const channels = [
 {id:'kick',name:'Cassa',key:'1',color:'#ffbd8e'},
 {id:'clap',name:'Clap',key:'2',color:'#ff8bc7'},
 {id:'hat',name:'Hat',key:'3',color:'#91eced'},
 {id:'acid',name:'Acid',key:'4',color:'#c7a0ff'},
];
---
<div class="bside-discovery">
 <button id="bside-entry" type="button" aria-label="Scopri il lato B" aria-haspopup="dialog" aria-controls="bside-room"><span class="bside-secret-record" aria-hidden="true"><i>B</i></span><span class="bside-door-copy">C’è un altro lato.</span></button>
</div>
<dialog id="bside-room" aria-labelledby="bside-title" aria-describedby="bside-description" data-playing="false" data-light="violet">
 <div class="bside-shell">
  <div class="bside-chrome"><a class="bside-identity" href="#" aria-label="KIST, chiudi il lato B"><img src="/media/kist-wordmark-v2.svg" width="86" height="28" alt="KIST"/><span>lato B</span></a><span class="bside-room-time"><i></i> Bologna, fuori orario.</span><button id="bside-close" type="button" aria-label="Chiudi il lato B" autofocus><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
  <div class="bside-intro"><div><p class="bside-found">Bravo. Hai guardato fino in fondo.</p><h2 id="bside-title">Il bello è<br/>dall’altro lato.</h2></div><p id="bside-description">Qui la notte la fai tu.<br/>Accendi la console. Trova il tuo ritmo.</p></div>
  <div class="bside-studio" aria-label="Lo studio segreto di KIST">
   <div class="bside-room-wash" aria-hidden="true"></div>
   <div class="bside-wall-word" aria-hidden="true">B—SIDE</div>
   <div class="bside-window" aria-hidden="true"><div class="bside-window-sky"></div><div class="bside-moon"></div><svg class="bside-skyline" viewBox="0 0 360 240"><path d="M0 225V166h38v-18h48v28h28V81h22v-9h16v153h15V46h19V31h8v15h18v179h24v-59h24v-16h49v22h51v53Z"/><path class="bside-window-lights" d="M119 105h7v10h-7zm0 32h7v10h-7zm0 32h7v10h-7zm59-96h7v10h-7zm0 34h7v10h-7zm0 34h7v10h-7zm0 34h7v10h-7zM12 185h7v10h-7zm32-22h7v10h-7zm210 13h7v10h-7zm31 15h7v10h-7z"/></svg><div class="bside-window-cross"></div><span>44°29′ N / 11°20′ E</span></div>
   <div class="bside-speaker bside-speaker-left" aria-hidden="true"><span></span><i></i><b></b></div><div class="bside-speaker bside-speaker-right" aria-hidden="true"><span></span><i></i><b></b></div>
   <button class="bside-snapshot" id="bside-photo" type="button" aria-label="Gira la foto di KIST" aria-pressed="false"><span class="bside-snapshot-front"><img src="/media/kist-fifteen-frames-clean-second.webp" width="200" height="150" alt="KIST alla console" loading="lazy"/><span>one more track.</span></span><span class="bside-snapshot-back"><img src="/media/hero/kist-mural-portrait-mobile-v1.webp" width="200" height="150" alt="KIST con le cuffie davanti a un murale" loading="lazy"/><span>always KIST.</span></span></button>
   <div class="bside-neon" aria-hidden="true">ancora una.</div>
   <div class="bside-character"><KistSprite mode="mix" size={210} label="KIST alla console del lato B"/></div>
   <div class="bside-desk" aria-hidden="true"><div class="bside-deck bside-deck-left"><div class="bside-vinyl"><span><img src="/kist-sigil.svg" alt="" width="28" height="28"/></span></div><div class="bside-tonearm"></div><i class="bside-deck-led"></i></div><div class="bside-mixer"><div class="bside-meter"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="bside-knobs"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="bside-faders"><i></i><i></i><i></i></div><span>K / B</span></div><div class="bside-deck bside-deck-right"><div class="bside-vinyl"><span>B</span></div><div class="bside-tonearm"></div><i class="bside-deck-led"></i></div></div>
   <div class="bside-desk-edge" aria-hidden="true"><span>Personal frequency / private room</span><i></i></div>
   <button id="bside-lights" type="button" aria-label="Cambia la luce dello studio" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6m-5 3h4M8 14a6 6 0 1 1 8 0c-1 1-1 2-1 2H9s0-1-1-2Z"/></svg><span>Luci</span></button>
  </div>
  <div class="bside-instrument">
   <div class="bside-transport"><button id="bside-start" type="button"><svg class="bside-start-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7Z"/></svg><span>Accendi la stanza</span></button><div class="bside-clock"><span class="bside-clock-dot"></span><output id="bside-beat" aria-label="Battuta">01.1</output><span>/ loop</span></div><button id="bside-shuffle" type="button" aria-label="Crea un altro ritmo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h3c5 0 7 12 12 12h3m-4-4 4 4-4 4M3 18h3c2 0 3-2 5-6m3-4c1-1 2-2 4-2h3m-4-4 4 4-4 4"/></svg><span>Un’altra notte</span></button></div>
   <div class="bside-performance"><div class="bside-pads" role="group" aria-label="Suona i quattro pad">{channels.map(channel=><button class="bside-pad" type="button" data-bside-pad={channel.id} style={'--pad-color:'+channel.color} aria-label={'Suona '+channel.name}><span class="bside-pad-top"><i></i><kbd>{channel.key}</kbd></span><strong>{channel.name}</strong><span class="bside-pad-lines" aria-hidden="true"></span></button>)}</div><div class="bside-dials"><label class="bside-dial"><span>Velocità <output id="bside-tempo-value" for="bside-tempo">132</output><small>BPM</small></span><input id="bside-tempo" type="range" min="110" max="150" value="132" aria-label="Velocità del ritmo"/></label><label class="bside-dial"><span>Filtro <small>chiuso / aperto</small></span><input id="bside-filter" type="range" min="0" max="100" value="58" aria-label="Filtro del suono"/></label></div></div>
   <details class="bside-pattern"><summary>Entra nel ritmo<span>Disegna la tua sequenza <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 8 5 5 5-5"/></svg></span></summary><div class="bside-sequencer-scroll" tabindex="0" role="region" aria-label="Sequencer, scorri per tutti i sedici passi"><div class="bside-sequencer">{channels.map(channel=><div class="bside-sequence" style={'--pad-color:'+channel.color}><button type="button" data-bside-channel={channel.id} aria-label={'Disattiva '+channel.name} aria-pressed="true">{channel.name}</button><div>{Array.from({length:16},(_,step)=><button type="button" data-bside-step data-channel={channel.id} data-step={step} aria-label={channel.name+', passo '+(step+1)} aria-pressed="false"><span>{step+1}</span></button>)}</div></div>)}</div></div><p>Tocca i passi per scrivere il loop. I nomi accendono e spengono le singole voci.</p></details>
  </div>
  <div class="bside-outro"><p id="bside-status" role="status" aria-live="polite">Hai trovato la stanza. Adesso falla suonare.</p><button id="bside-share" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-2 2m3 6a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l2-2"/></svg><span>Passa la chiave</span></button></div>
  <div class="bside-signature" aria-hidden="true"><span>You found the B-side.</span><img src="/kist-sigil.svg" width="22" height="22" alt=""/><span>Keep the night going.</span></div>
 </div>
</dialog>
<script src="../scripts/bside.ts"></script>
