---
type Event={date:string;name:string;place:string;url:string;cover?:string;time:string;organizer:string};
interface Props {items:Event[];label:string}
const {items,label}=Astro.props;
---
<div class="night-viewer" aria-label={label}>
{items.length ? <>
 <div class="night-topline"><div class="night-titles">{items.map((event,i)=><h3 hidden={i!==0} data-night-title={i}>{event.name}</h3>)}</div><div class="night-navigation"><span class="night-count">01 / {String(items.length).padStart(2,'0')}</span><button class="night-prev" aria-label="Evento precedente" disabled={items.length<2}><span class="ui-icon icon-arrow icon-left" aria-hidden="true"></span></button><button class="night-next" aria-label="Evento successivo" disabled={items.length<2}><span class="ui-icon icon-arrow" aria-hidden="true"></span></button></div></div>
 <div class="night-stage" aria-label="Scorri le copertine degli eventi">{items.map((event,i)=><button class="night-sleeve" data-index={i} data-position={i===0?0:i===1?1:-1} aria-pressed={i===0} aria-label={'Mostra '+event.name}><img src={event.cover} alt={'Locandina '+event.name} loading="lazy"/><span class="night-spine">KIST / {event.date.slice(0,4)}</span></button>)}</div>
 <div class="night-panels" aria-live="polite">{items.map((event,i)=><article class="night-details" hidden={i!==0}><div class="night-calendar"><time datetime={event.date}><b>{event.date.slice(8)}</b><span>{new Date(event.date+'T12:00:00').toLocaleDateString('it-IT',{month:'short'})}</span></time></div><dl class="night-meta"><div class="night-time"><dt>Ora</dt><dd>{event.time}</dd></div><div class="night-place"><dt>Luogo</dt><dd>{event.place}</dd></div><div class="night-organizer"><dt>Organizza</dt><dd>{event.organizer}</dd></div></dl><a class="night-link" href={event.url} target="_blank" rel="noopener noreferrer">La serata <span class="ui-icon icon-external" aria-hidden="true"></span></a></article>)}</div>
 </> : <div class="night-empty"><span>La prossima notte è ancora da scrivere.</span><a href="https://www.instagram.com/thats_kist/" target="_blank" rel="noopener noreferrer">Le nuove date su Instagram <span class="ui-icon icon-external" aria-hidden="true"></span></a></div>}
</div>
