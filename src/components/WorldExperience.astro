---
const districts = [
 {id:'home',name:'L’arrivo',detail:'Bologna, dopo il tramonto'},
 {id:'sound',name:'Il suono',detail:'Le selezioni di KIST'},
 {id:'diary',name:'La piazza',detail:'Le notti, passate e future'},
 {id:'places',name:'Le connessioni',detail:'I luoghi della città'},
 {id:'about',name:'La terrazza',detail:'La persona dietro il suono'},
 {id:'contact',name:'La prossima notte',detail:'Facciamola succedere'},
];
const environments = [
 {src:'/media/world/bologna-portici-v1.webp',name:'portici'},
 {src:'/media/world/bologna-piazza-v1.webp',name:'piazza'},
 {src:'/media/world/bologna-rooftops-v1.webp',name:'rooftops'},
];
---
<div id="kist-world" class="world-scene" aria-hidden="true" data-world-chapter="0" data-world-paused="false">
 <div class="world-environments">{environments.map((environment,i)=><img class="world-backdrop" data-world-art={i} data-environment={environment.name} src={environment.src} alt="" decoding="async" loading="eager" fetchpriority="low" style={'opacity:'+(i===0?1:0)}/>)}</div>
 <canvas id="kist-world-canvas"></canvas><img class="world-foreground" data-world-foreground src="/media/world/bologna-foreground-v1.webp" alt="" decoding="async" loading="eager" fetchpriority="low"/><div class="world-reading-light"></div>
</div>
<aside class="world-dock" aria-label="Mondo KIST">
 <div class="world-map" id="world-map" hidden>
  <div class="world-map-heading"><span>BOLOGNA / PERSONAL FREQUENCY</span><strong>La città.<br/>Sulla tua frequenza.</strong><p>Dai portici alla piazza, fino ai tetti. Scorri o scegli dove andare.</p></div>
  <nav aria-label="Esplora il mondo KIST"><ol>{districts.map((district,i)=><li><a href={'#'+district.id} data-world-route={i}><span class="world-route-number">0{i+1}</span><span><strong>{district.name}</strong><small>{district.detail}</small></span><span aria-hidden="true">↗</span></a></li>)}</ol></nav>
  <div class="world-map-foot"><span data-world-audio>La città aspetta il suono.</span><a href="#sound">Ascolta le selezioni <span aria-hidden="true">↗</span></a></div>
 </div>
 <div class="world-dock-bar">
  <button id="world-map-toggle" aria-expanded="false" aria-controls="world-map"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z M9 3v15 M15 6v15"/></svg><span><small>BOLOGNA / KIST WORLD</small><strong data-world-label>L’arrivo</strong></span><span class="world-audio-light" aria-hidden="true"></span></button>
  <button id="world-motion" aria-pressed="false" aria-label="Metti in pausa lo sfondo"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5v10 M13 5v10"/></svg></button>
 </div>
 <div class="world-route-progress" aria-hidden="true">{districts.map((_,i)=><i data-world-stop={i}></i>)}</div>
</aside>
