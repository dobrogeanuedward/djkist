---
import { artist, mixes, photographs, events, heroSlides } from '../data/artist';
import '../styles/global.css';
import '../styles/polish.css';
import '../styles/vinyl.css';
import '../styles/transport.css';
import '../styles/festival.css';
import EventViewer from '../components/EventViewer.astro';
import HostedBy from '../components/HostedBy.astro';
import ContactSection from '../components/ContactSection.astro';
import KistSprite from '../components/KistSprite.astro';
import WorldGate from '../components/WorldGate.astro';
import ArtistDiscovery from '../components/ArtistDiscovery.astro';
import DiscoverySchema from '../components/DiscoverySchema.astro';
import LiveSessionsLibrary from '../components/LiveSessionsLibrary.astro';
import NightSky from '../components/NightSky.astro';
import '../styles/places.css';
import '../styles/sprites.css';
import '../styles/opening.css';
import '../styles/desktop.css';
import '../styles/world.css';
import '../styles/hero-video.css';
import '../styles/artist-polish.css';
import '../styles/header-refinement.css';
import '../styles/hero-center.css';
const today = new Date().toLocaleDateString('en-CA', {timeZone:'Europe/Rome'});
const future = events.filter(e => e.date >= today).sort((a,b)=>a.date.localeCompare(b.date));
const past = events.filter(e => e.date < today).sort((a,b)=>b.date.localeCompare(a.date));
const showFuture = future.length > 0;
const featured = mixes[0];
const siteUrl = 'https://www.djkist.it/';
const pageTitle = 'DJ KIST — Benedetta Pasquariello, DJ a Bologna';
const pageDescription = 'Benedetta Pasquariello, in arte DJ KIST: DJ a Bologna. Breakbeat, UK garage, jungle, drum and bass e acid techno. Set, video, booking e collaborazioni.';
const shareImage = new URL(artist.hero, siteUrl).href;
const artistId = siteUrl + '#kist';
const structuredData = {
 '@context': 'https://schema.org',
 '@graph': [
  {
   '@type': 'Person', '@id': artistId, name: 'KIST', alternateName: ['DJ KIST', 'Benedetta Pasquariello'], url: siteUrl,
   jobTitle: 'DJ e selector', description: artist.bio, image: shareImage,
   homeLocation: {'@type': 'City', name: 'Bologna', containedInPlace: {'@type': 'Country', name: 'Italia'}},
   sameAs: [artist.instagram, artist.soundcloud],
  },
  {
   '@type': 'WebSite', '@id': siteUrl + '#website', url: siteUrl,
   name: 'DJ KIST — Personal frequency', inLanguage: 'it-IT', publisher: {'@id': artistId},
  },
  {
   '@type': 'WebPage', '@id': siteUrl + '#webpage', url: siteUrl,
   name: pageTitle, description: pageDescription, inLanguage: 'it-IT',
   isPartOf: {'@id': siteUrl + '#website'}, mainEntity: {'@id': artistId},
  },
 ],
};
---
<!doctype html>
<html lang="it">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{pageTitle}</title>
<meta name="description" content={pageDescription}/>
<meta name="google-site-verification" content="gAxsFQaCnf3U3ANkMLOC7j8IbrIsrUkQu9C3DJwvMbA"/>
<meta name="theme-color" content="#111113"/><meta name="robots" content="index,follow,max-image-preview:large"/>
<link rel="canonical" href={siteUrl}/>
<meta property="og:type" content="website"/>
<meta property="og:locale" content="it_IT"/>
<meta property="og:site_name" content="DJ KIST"/>
<meta property="og:title" content={pageTitle}/>
<meta property="og:description" content={pageDescription}/>
<meta property="og:url" content={siteUrl}/>
<meta property="og:image" content={shareImage}/>
<meta property="og:image:alt" content="DJ KIST alla console durante Fifteen Frames"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={pageTitle}/>
<meta name="twitter:description" content={pageDescription}/>
<meta name="twitter:image" content={shareImage}/>
<meta name="twitter:image:alt" content="DJ KIST alla console durante Fifteen Frames"/>
<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}/>
<DiscoverySchema/>
<link rel="icon" href="/favicon.svg"/>
<link rel="preload" as="image" href="/media/world/bologna-portici-v1.webp" fetchpriority="low"/>
<link rel="preload" as="image" href="/media/kist/kist-16bit-mix-poster.webp"/>
<link rel="preload" as="image" href="/media/kist/kist-16bit-mix.webp"/>
</head>
<body>
<a class="skip" href="#main">Vai al contenuto</a>
<div class="entrance entrance-refined" aria-hidden="true"><canvas class="entrance-waves"></canvas><div class="entrance-identity"><span class="entrance-dj">DJ</span><div class="entrance-mark"><img class="entrance-wordmark" src="/media/kist-wordmark-imagegen.webp" alt=""/><div class="entrance-character"><div class="entrance-character-motion"><KistSprite mode="mix" size={124} opening eager/></div></div></div><span class="entrance-location">BASED IN BOLOGNA</span></div></div>
<header class="site-header">
<a class="brand" href="#home" aria-label="KIST, inizio"><img src="/media/kist-wordmark-imagegen.webp" alt="KIST"/></a>
<button id="header-nav-toggle" class="header-nav-toggle" aria-expanded="false" aria-controls="site-navigation" hidden><span>Menu</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 7h14M3 13h14"/></svg></button>
<nav id="site-navigation" class="site-nav" aria-label="Menu principale"><a href="#sound" aria-label="Sound">Sound</a><a href="#sessions" aria-label="Sessioni live">Sessioni</a><a href="#frequency-break" aria-label="Mondo KIST">Mondo KIST</a><a href="#diary" aria-label="Notti">Notti</a><a href="#places" aria-label="Luoghi">Luoghi</a><a href="#about" aria-label="Kist">Kist</a><a href="#contact" aria-label="Contatti">Contatti</a></nav>
<div class="header-actions"><div class="listen-social"><button id="header-music" class="header-music" aria-describedby="header-track-title" aria-label="Attiva la musica" aria-pressed="false"><img class="header-track-cover" data-track-cover src={featured?.artwork || artist.hero} width="42" height="42" alt=""/><span class="header-track-copy"><small>KIST / SOUNDCLOUD</small><strong id="header-track-title" data-track-title>{featured?.title || 'Personal frequency'}</strong></span><span class="header-listen-icon ui-icon icon-play" aria-hidden="true"></span></button></div><div class="header-transport-slot"></div></div>
</header>
<main id="main">
<section class:list={['hero',{'is-photo':!!artist.heroVideo}]} id="home" data-hero-index="0">
<div class="hero-media"><canvas id="prism" data-prism aria-hidden="true"></canvas>
{!artist.heroVideo && heroSlides.length > 0 && <div class="hero-slides">{heroSlides.map((slide,i)=><picture class={'hero-slide'+(i===0?' active':'')} style={'--position:'+ (slide.position||'center')+';--mobile-position:'+(slide.mobilePosition||slide.position||'center')}><source media="(max-width:700px)" srcset={slide.mobile||slide.src}/><img src={slide.src} alt={slide.alt} fetchpriority={i===0?'high':'auto'} loading={i===0?'eager':'lazy'}/></picture>)}</div>}{!artist.heroVideo && artist.hero && heroSlides.length===0 && <picture><source media="(max-width: 700px)" srcset={artist.heroMobile || artist.hero}/><img src={artist.hero} alt="KIST" fetchpriority="high"/></picture>}
{artist.heroVideo && <><video id="hero-video" class="hero-video" muted loop playsinline preload="metadata" poster={artist.heroVideoPoster} data-desktop={artist.heroVideo} data-mobile={artist.heroVideoMobile} data-desktop-poster={artist.heroVideoPoster} data-mobile-poster={artist.heroVideoMobilePoster} data-hero-index="0" data-hero-sequence={JSON.stringify([
 {type:'photo',duration:4000,desktop:heroSlides[0]?.src||artist.hero,mobile:heroSlides[0]?.mobile||artist.heroMobile||artist.hero,desktopPosition:heroSlides[0]?.position||'center 58%',mobilePosition:heroSlides[0]?.mobilePosition||'48% 58%'},
 {type:'video',duration:5000,desktop:artist.heroVideo,mobile:artist.heroVideoMobile,desktopPoster:artist.heroVideoPoster,mobilePoster:artist.heroVideoMobilePoster,desktopPosition:'50% 46%',mobilePosition:'25% center'},
 {type:'photo',duration:3500,desktop:'/media/hero/kist-mural-portrait-desktop-v1.webp',mobile:'/media/hero/kist-mural-portrait-mobile-v1.webp',desktopPosition:'center',mobilePosition:'center'},
 {type:'video',duration:5000,desktop:'/media/hero/kist-purple-desktop-v1.mp4',mobile:'/media/hero/kist-purple-mobile-v1.mp4',desktopPoster:'/media/hero/kist-purple-desktop-poster-v1.webp',mobilePoster:'/media/hero/kist-purple-mobile-poster-v1.webp',desktopPosition:'center',mobilePosition:'center'},
 ])} aria-hidden="true" tabindex="-1"></video><img id="hero-sequence-photo" class="hero-sequence-photo" src={artist.hero} alt="" aria-hidden="true" decoding="async" loading="eager" fetchpriority="low"/></>}
<div class="grain"></div>
</div>
<div class="hero-top"><span>DJ / SELECTOR</span><span>BOLOGNA · IT</span></div>
<div class="hero-title"><span class="small">You're in my space.</span><h1><img src="/media/kist-wordmark-imagegen.webp" alt="DJ KIST — Benedetta Pasquariello, DJ e selector a Bologna"/></h1></div>
<div class="hero-bottom"><button class="hero-listen" id="hero-listen" aria-label="Apri il player di KIST"><span>Riproduci</span><i aria-hidden="true"></i></button>
<div class="sound-invitation" data-url={featured?.url || artist.soundcloud} data-mixes={JSON.stringify(mixes)}>
<div class="mini-record" aria-hidden="true"><img src="/media/kist-fifteen-frames-clean-v2.webp" alt=""/></div>
<div class="sound-caption"><span>THIS SPACE SOUNDS BETTER WITH MUSIC</span><span>01 / SOUND ON</span></div>
<div class="sound-row"><div><strong>{featured?.title || 'La prossima selezione'}</strong><p id="audio-status" role="status">{featured || artist.soundcloud ? 'Entra con il suono.' : 'Il primo ascolto arriva presto.'}</p></div><button class="play" id="hero-play" aria-label="Riproduci il set di KIST" disabled={!featured && !artist.soundcloud}><span class="ui-icon icon-play" aria-hidden="true"></span><span class="mini-label">Riproduci</span></button><button id="quiet" class="quiet">Per ora, in silenzio</button></div>
<canvas id="sound-prism" data-prism aria-hidden="true"></canvas>
</div>
</div>
<div class="hero-foot">{artist.heroVideo ? <div class="slideshow-controls"><button id="slides-toggle" data-video-toggle aria-label="Metti in pausa la sequenza visiva" aria-pressed="false"><span class="ui-icon icon-pause" aria-hidden="true"></span></button><span class="video-caption">BOLOGNA / LIVE MOMENTS <span id="hero-sequence-count" aria-hidden="true">01 / 04</span></span></div> : heroSlides.length>1 && <div class="slideshow-controls"><button id="slides-toggle" aria-label="Metti in pausa lo slideshow" aria-pressed="false"><span class="ui-icon icon-pause" aria-hidden="true"></span></button><span id="slide-count">01 / {String(heroSlides.length).padStart(2,'0')}</span></div>}<span>SCROLL TO FEEL MORE</span><span>PERSONAL FREQUENCY / 2026</span></div>
</section>
<div class="ticker" aria-hidden="true"><div>FEEL THE ROOM. FIND YOUR FREQUENCY. KIST. FEEL THE ROOM. FIND YOUR FREQUENCY. KIST.</div></div>
<section class="sound-section section" id="sound">
<div class="section-heading"><h2 class="prismatic-title">Sound.</h2></div>
<div class="record-shelf">{mixes.map((mix,i)=><button class="record-card" data-mix={mix.url} aria-pressed="false" style={'--tone:'+mix.palette+';--accent:'+mix.accent+';--art:url('+mix.artwork+')'}><span class="record-edition">0{i+1} / KIST</span><div class="record-object">{mix.sleeve?<img src={mix.sleeve} alt={'Copertina e vinile di '+mix.title} loading="lazy"/>:<img class="original-sleeve" src={mix.artwork} alt={'Copertina originale di '+mix.title} loading="lazy"/>}</div><div class="record-info"><span class="record-genre">{mix.label}</span><h3>{mix.title}</h3><span class="record-control"><i class="mix-play ui-icon icon-play" aria-hidden="true"></i><span class="mix-action">Riproduci</span></span></div></button>)}</div><a class="sound-profile" href={artist.soundcloud} target="_blank" rel="noopener noreferrer">Tutte le selezioni su SoundCloud <i class="ui-icon icon-external" aria-hidden="true"></i></a>
</section>
<LiveSessionsLibrary/>
<WorldGate/><section class="diary section" id="diary">
<NightSky/>
<div class="night-heading"><h2 class="prismatic-title">Notti.</h2><span>Passate e future.</span></div>
<div class="night-tabs" role="group" aria-label="Mostra eventi"><button aria-pressed={!showFuture} data-events="past">Passate <span>{past.length}</span></button><button aria-pressed={showFuture} data-events="future">Future <span>{future.length}</span></button></div>
<div id="past-events" hidden={showFuture}><EventViewer items={past} label="Archivio eventi di KIST"/></div><div id="future-events" hidden={!showFuture}><EventViewer items={future} label="Prossimi eventi di KIST"/></div>
</section>
{photographs.length > 0 && <section class="photo-wall" aria-label="Diario fotografico">{photographs.map((photo,i)=><button class={'photo photo-'+i%3} data-photo={photo.src} data-caption={photo.caption} aria-label={'Ingrandisci: '+photo.alt}><img src={photo.src} alt={photo.alt} loading="lazy"/><span>{photo.caption}</span></button>)}</section>}

<HostedBy/>
<section class="about section" id="about"><div class="about-photo">{artist.portrait ? <img src={artist.portrait} alt="Ritratto di KIST" loading="lazy"/> : <div class="portrait-await"><span>BEHIND THE SOUND</span><img src="/media/kist-wordmark-imagegen.webp" alt="KIST"/></div>}</div><div class="about-copy"><span>04 / A LITTLE CLOSER</span><h2>La musica.<br/>E chi la sceglie.</h2>{artist.bio.split('\n\n').map(paragraph=><p>{paragraph}</p>)}<a href={artist.instagram} target="_blank" rel="noopener noreferrer">@thats_kist <span class="ui-icon icon-external" aria-hidden="true"></span></a></div></section>
<ArtistDiscovery/>
<ContactSection/>
</main>
<footer><img src="/media/kist-wordmark-imagegen.webp" alt="KIST"/><span>PERSONAL FREQUENCY</span><a href={artist.soundcloud} target="_blank" rel="noopener noreferrer" aria-label="KIST su SoundCloud">SoundCloud</a><a href={artist.instagram} target="_blank" rel="noopener noreferrer" aria-label="KIST su Instagram">Instagram</a><a href="https://www.youtube.com/results?search_query=KIST+Fifteen+Frames+Bologna" target="_blank" rel="noopener noreferrer" aria-label="Cerca KIST e Fifteen Frames su YouTube">YouTube</a><a href="/media/FREQUENCY-BODY-LICENSE.txt">3D credits</a><span>Crafted by DOGO Studio · 2026</span></footer>
<dialog id="media-dialog"><button class="close-dialog" aria-label="Chiudi"><span class="ui-icon icon-close" aria-hidden="true"></span></button><div id="dialog-content"></div></dialog>
<dialog id="sound-dialog" aria-labelledby="sound-dialog-title"><div class="player-stage"><canvas data-prism aria-hidden="true"></canvas><button id="player-dismiss" class="player-dismiss" aria-label="Chiudi il player"><span class="ui-icon icon-close" aria-hidden="true"></span></button><div class="player-intro"><img src="/kist-sigil.svg" alt=""/><span>KIST / SoundCloud</span></div><div class="player-scene"><div class="vinyl-scene" aria-hidden="true"><div class="vinyl-disc"><div class="vinyl-art"><img src="/media/kist-fifteen-frames-clean-v2.webp" alt=""/></div><i></i></div><div class="vinyl-needle"></div></div><div class="player-character" aria-hidden="true"><KistSprite mode="mix" size={144}/></div></div><div class="player-copy"><h2 id="sound-dialog-title">Apri il sito di DJ KIST<br/>ascoltando i suoi brani.</h2><p>{featured?.title || 'Personal frequency'}</p></div><div class="player-actions"><button id="popup-play" class="popup-play"><span class="ui-icon icon-play" aria-hidden="true"></span><span class="button-label">Daje</span></button><button id="popup-quiet">Continua senza musica</button></div><p id="popup-status" role="status" aria-live="polite"></p><div id="player-mount"></div><a class="player-source" href={featured?.url || artist.soundcloud} target="_blank" rel="noopener noreferrer">SoundCloud <span class="ui-icon icon-external" aria-hidden="true"></span></a></div></dialog>
<div class="audio-dock" role="group" aria-label="Lettore SoundCloud" hidden><button id="dock-open" aria-label="Apri il player" aria-describedby="dock-title"><img id="dock-cover" class="header-track-cover" data-track-cover src={featured?.artwork || artist.hero} width="42" height="42" alt=""/><span class="header-track-copy"><small data-track-status>IN ASCOLTO</small><strong id="dock-title" data-track-title>{featured?.title || 'Personal frequency'}</strong></span></button><button id="dock-toggle" aria-label="Metti in pausa il set"><span class="ui-icon icon-pause" aria-hidden="true"></span><span class="transport-label">Pausa</span></button><button id="dock-close" aria-label="Chiudi il lettore"><span class="ui-icon icon-close" aria-hidden="true"></span></button></div>
<script src="../scripts/experience.ts"></script><script src="../scripts/prism.ts"></script>
<script src="../scripts/section-motion.ts"></script>
<script src="../scripts/world.ts"></script>
<script src="../scripts/hero-video.ts"></script>
</body></html>
